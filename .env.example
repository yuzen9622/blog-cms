HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (PostgreSQL)
DATABASE_CLIENT=postgres
# 本機開發用 localhost；docker compose 會自動覆蓋成 postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=changeme
DATABASE_SSL=false

# Cloudinary（媒體庫上傳，provider 設定在 config/plugins.ts）
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Cloudflare Tunnel token（cloudflare-tunnel 服務透過 TUNNEL_TOKEN 使用；
# 由 `cloudflared tunnel token create <name>` 或 Zero Trust dashboard 取得）
CLOUDFLARE_TOKEN=
